# -------------------------------------------------------------------
# .bash_aliases
#
# Aliases I like and use. Aliases can only add arguments at the end of
# a command, so anything that needs them elsewhere is a function at
# the bottom of this file.
# -------------------------------------------------------------------

# ls color flag: GNU ls uses --color=auto, macOS ls uses -G
if [[ -z "${colorflag:-}" ]]; then
  if ls --color=auto -d . >/dev/null 2>&1; then colorflag="--color=auto"; else colorflag="-G"; fi
fi

# Movement
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias bk='cd "$OLDPWD"'

alias code='cd ~/code'
alias dots='cd ~/.dotfiles'
alias godev='cd ~/code/go/src/github.com/zanshin'
alias rsdev='cd ~/code/rust'

# ls variants
alias ls="ls $colorflag"
alias l="ls -lahF"
alias ll="ls -lhF"
alias lsd='ls -ld */'
alias lh='ls -a | grep -e "^\."'
alias l.='ls -ld .?*'
alias lst='ls -alt'
alias latr='ls -latr'
alias sym="ls -la | grep '\->'"

# Searching, history, sizes
alias a='alias | grep'
alias galias='alias | grep'
alias h='history | grep'
alias previous='history | grep'
alias psg='ps aux | grep -v grep | grep -i -e VSZ -e'
alias dus='du -schx * | sort -hr'
alias dh="df -h | head -1; df -h | grep '\s\/Volumes\|Data' | grep -v 'map\|.time'"

# Safety and sudo
alias rm='rm -i'
alias sudo='sudo '              # trailing space lets aliases work after sudo
alias hosts='sudo -e /etc/hosts'

# Git
alias ga='git add'
alias gb='git branch'
alias gc='git checkout'
alias gcb='git checkout -b'
alias gcl='git clone'
alias gcm='git commit'
alias gm='git commit -m'
alias gma='git commit -am'
alias gd='git diff'
alias gdb='git diff master..HEAD'
alias gr='git diff master..'
alias gf='git reflog'
alias gl='git log'
alias gpl="git log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all"
alias gp='git push'
alias gpu='git pull'
alias gra='git remote add'
alias grr='git remote rm'
alias gs='git status'
alias gta='git tag -a -m'
alias gu='git up'               # git-up gem, or a `git up` alias in ~/.gitconfig
alias gh='git hist'             # ~/.gitconfig alias
alias gt='git today'            # ~/.gitconfig alias
alias gv="git log --pretty=format:'%s' | cut -d ' ' -f 1 | sort | uniq -c | sort -nr"
alias gsh="git shortlog | grep -E '^[ ]+\w+' | wc -l"     # commit count
alias guser="git shortlog | grep -E '^[^ ]'"               # commits per developer
alias cssh='chmod 600 ~/.dotfiles/ssh/config ~/.dotfiles/ssh/authorized_keys 2>/dev/null'

# Jujutsu (jj)
alias jl='jj log'
alias jh="jj history -r 'all()'"

# Rust / Cargo
alias rust='rustc --version && cargo --version'
alias cr='cargo run'
alias ct='cargo test'
alias crt='RUST_LOG=trace cargo run'
alias ctt='RUST_LOG=trace cargo test -- --nocapture'
alias rstree='tree -I target/'

# Ruby / Python
alias ri='ri -Tf ansi'
alias python='python3'
alias mkenv='mkvirtualenv'
alias on='workon'
alias off='deactivate'

# Neovim and Vim
alias vi='nvim'
alias nv='nvim'
alias vim='vim -U none'
alias vplug='vim +PlugUpgrade +PlugUpdate +qall'
alias nplug='nvim +PlugUpgrade +PlugUpdate +qall'
alias nvimks='NVIM_APPNAME=nvim-kickstart nvim'
alias nvimmin='NVIM_APPNAME=nvim-minimum nvim'
alias nvimbb='NVIM_APPNAME=nvim-barebones nvim'
alias update-nvim='asdf uninstall neovim nightly && asdf install neovim nightly'

# Tmux
alias attach='tmux attach -t base || tmux new -s base'
alias takeover='tmux detach -a'
alias ta='tmux attach -t'
alias tn='tmux new -s'
alias tls='tmux ls'
alias tk='tmux kill-session -t'
alias ts='tsession.sh'
alias tf='tmux-sessionizer'
alias resetmouse="printf '\e[?1000l'"    # turn off mouse reporting after a tmux crash

# Mail
alias mutt='(cd ~/Desktop && mutt)'      # subshell: back in the original dir even if mutt fails
alias nmutt='(cd ~/Desktop && neomutt)'

# Vagrant
alias vg='vagrant'
alias vs='vagrant ssh'
alias vu='vagrant up'
alias vp='vagrant provision'
alias vh='vagrant halt'
alias vr='vagrant reload'
alias vd='vagrant destroy'
alias vgs='vagrant global-status'

# Docker
alias d='docker'
alias dclean='docker rm -v $(docker ps -aq -f status=exited)'
alias dm='docker-machine'
alias dmenv='eval "$(docker-machine env local)"'

# Miscellaneous
alias acat='source ~/.bash_aliases'
alias facat='source ~/.bash_functions'
alias sb='source ~/.bashrc'
alias ai='~/bin/bash/appender.sh'
alias t='todo.sh -d ~/.config/todo/todo.cfg'
alias adventure='emacs -batch -l dunnet'
alias makepass='openssl rand -base64 12'
alias rot13='tr a-zA-Z n-za-mN-ZA-M'
alias untar='tar xvf'
alias fail='tail -f'
alias wttr='curl wttr.in'
alias ipp='dig +short myip.opendns.com @resolver1.opendns.com'
alias sloc='/usr/local/sloccount/bin/sloccount'

# OS-specific
if [[ "$OSTYPE" == darwin* ]]; then
  alias bu='brew update; brew upgrade; brew upgrade --cask; brew cleanup; brew doctor'
  alias mailsize='du -hs ~/Library/mail'
  alias ttop='top -ocpu -R -F -s 2 -n30'
  alias dismount="osascript -e 'tell application \"Finder\" to eject (every disk whose ejectable is true)'"
  alias resetdns='sudo killall -HUP mDNSResponder'
  alias flush='dscacheutil -flushcache && sudo killall -HUP mDNSResponder'
  alias wifi='networksetup -setairportpower en0'
  alias brave='open -a "/Applications/Brave Browser.app" --args --proxy-server="socks5://localhost:54321"'
else
  alias xup='xrdb ~/.Xresources'
  alias ss='sudo systemctl'
  alias ssu='sudo systemctl start'
  alias ssd='sudo systemctl stop'
  alias ssr='sudo systemctl restart'
  alias sse='sudo systemctl enable'
  alias packages='echo "$(pacman -Qn | wc -l) Arch packages, and $(pacman -Qm | wc -l) AUR packages"'
fi

# Functions: these need their arguments somewhere other than the end
# (unalias first, so re-sourcing a shell that still has the old aliases works)
unalias define has gtail please ect gua gmass 2>/dev/null

# define WORD: dictionary lookup
function define { curl -s "dict://dict.org/define:$1"; }

# has PATTERN [DIR]: list files under DIR (default .) containing PATTERN, ignoring case
function has { grep -rli -- "$1" "${2:-.}"; }

# gtail FILE PATTERN: follow FILE, showing only lines matching PATTERN
function gtail { tail -f "$1" | grep --line-buffered -- "$2"; }

# please: rerun the previous command with sudo
function please { eval "sudo $(history -p '!!')"; }

# ect: open every file Git reports as changed in nvim
function ect { git status --short | awk '{print $2}' | xargs -o nvim; }

# gua: `git up` in each repository directly under the current directory
function gua {
  local g
  for g in */.git; do
    [[ -d "$g" ]] || continue
    printf '\nUpdating %s ...\n' "${g%/.git}"
    (cd "${g%/.git}" && git up)
  done
}

# gmass: check out master and `git up` in every repository below the current directory
function gmass {
  local g
  while IFS= read -r g; do
    echo "${g%/.git}"
    (cd "${g%/.git}" && git checkout master && git up)
  done < <(find . -type d -name .git -prune)
}
