#!/bin/bash

# --------------------------------------------------------------------
# exports
#
# Environment variables and shell settings. XDG comes first because
# several later exports are built from it.
# --------------------------------------------------------------------

# XDB base directories (macOS doesn't set these; keep any existing value)
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# Locale
export LANG="en_US.UTF-8" LC_ALL="en_US.UTF-8"

# Editor, pager, man
export VISUAL=nvim EDITOR=nvim PAGER=less LESS="-FRq" MANPAGER="nvim +Man!"

# Tools
export JJ_CONFIG="$XDG_CONFIG_HOME/jj"
export GOPATH="$HOME/code/golib:$HOME/code/go" GOPRIVATE="github.com/zanshin"
export CARGO_HOME="$HOME/.cargo" RUSTUP_HOME="$HOME/.rustup"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker" MACHINE_STORAGE_PATH="$XDG_DATA_HOME/docker-machine"
export GPG_TTY="$(tty)"

# Java: fixed path instead of `brew --prefix`, which starts Ruby on every shell
[[ -d /opt/homebrew/opt/openjdk ]] && export JAVA_HOME=/opt/homebrew/opt/openjdk

# OS-specific
if [[ "$OSTYPE" == darwin* ]]; then
  export BASH_SILENCE_DEPRECATION_WARNING=1
else
  export MOZ_ENABLE_WAYLAND=1  # Firefox native Wayland, not XWayland
  [[ -r /proc/cpuinfo && "$(</proc/cpuinfo)" == *Raspberry* ]] && export CC=/usr/bin/arm-linux-gnueabi-gcc
fi

# History
export HISTCONTROL=ignoredups:ignorespace  # skip dups and space-prefixed commands
export HISTSIZE=5000000 HISTFILESIZE=5000000
export HISTIGNORE=ls:ll:la:l:cd:pwd:exit:mc:su:df:clear:history
export HISTTIMEFORMAT="%y/%m/%d %T "
# PROMPT_COMMAND='history -a; history -c; history -r;'  # share history across sessions
PROMPT_COMMAND='history -a;'   # save all commands, only new shells see new history

# LS_COLORS (GNU ls / eza), one group per line
_lsc=(
  st=91 tw=91 no=00 fi=00 di=01\;34 ow=01\;31 ln=01\;36 pi=40\;33 so=01\;35 do=01\;35
  bd=40\;33\;01 cd=40\;33\;01 or=40\;31\;01 ex=01\;32
  # archives: red
  '*.tar=01;31' '*.tgz=01;31' '*.arj=01;31' '*.taz=01;31' '*.lzh=01;31' '*.zip=01;31'
  '*.z=01;31' '*.Z=01;31' '*.gz=01;31' '*.bz2=01;31' '*.deb=01;31' '*.rpm=01;31' '*.jar=01;31'
  # images, video, audio: magenta
  '*.jpg=01;35' '*.jpeg=01;35' '*.gif=01;35' '*.bmp=01;35' '*.pbm=01;35' '*.pgm=01;35'
  '*.ppm=01;35' '*.tga=01;35' '*.xbm=01;35' '*.xpm=01;35' '*.tif=01;35' '*.tiff=01;35'
  '*.png=01;35' '*.mov=01;35' '*.mpg=01;35' '*.mpeg=01;35' '*.avi=01;35' '*.fli=01;35'
  '*.gl=01;35' '*.dl=01;35' '*.xcf=01;35' '*.xwd=01;35' '*.ogg=01;35' '*.mp3=01;35' '*.wav=01;35'
)
printf -v LS_COLORS '%s:' "${_lsc[@]}"
export LS_COLORS

# Color variables for use elsewhere: Red, BRed, URed, On_Red, IRed,
# BIRed, On_IRed, and so on for all eight colors. Values are literal
# '\e[...m' strings, for use with echo -e, printf '%b', or PS1.
Color_Off='\e[0m'
_names=(Black Red Green Yellow Blue Purple Cyan White)
_styles=(       # prefix|code
  "|0;3"        # regular
  "B|1;3"       # bold
  "U|4;3"       # underline
  "On_|4"       # background
  "I|0;9"       # high intensity
  "BI|1;9"      # bold high intensity
  "On_I|0;10"   # high intensity background
)
for _s in "${_styles[@]}"; do
  for _i in "${!_names[@]}"; do
    printf -v "${_s%%|*}${_names[_i]}" '%s' "\\e[${_s#*|}${_i}m"
  done
done

unset _lsc _names _styles _s _i



