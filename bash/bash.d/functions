# vim: ft=bash
# -------------------------------------------------------------------
# functions
#
# Shell functions. Each is defined with the `function` keyword, so an
# alias with the same name can't turn the definition into a syntax
# error. loc uses the color variables from `exports`.
# -------------------------------------------------------------------

# SSH
# badkey LINE: delete line LINE from ~/.ssh/known_hosts
function badkey { nvim ~/.ssh/known_hosts +"$1d|x"; }

# ghostsync HOST: copy Ghostty's terminfo to HOST
function ghostsync {
  [[ -n "$1" ]] || { echo "Usage: ghostsync HOST" >&2; return 1; }
  infocmp -x | ssh "$1" -- tic -x -o \$HOME/.terminfo -
}

# Git and Jujutsu
# gg MESSAGE... / jc MESSAGE...: commit with an unquoted message
function gg { git commit -m "$*"; }
function jc { jj commit -m "$*"; }

# jtug BOOKMARK: move BOOKMARK to the parent of the working copy
function jtug { jj bookmark move --bookmark "$1" --to @-; }

# jj-short: `jj short` with the "time ago" column aligned
function jj-short {
  jj short -r 'all()' "$@" | awk '
  {
    # leading symbol (@ or similar), change id, author
    lead = $1; change_id = $2; author = $3

    # "time ago" is everything from field 4 through the word "ago"
    ago_idx = 0
    for (i = 4; i <= NF; i++) if ($i == "ago") { ago_idx = i; break }

    time_str = ""
    for (i = 4; i <= ago_idx; i++) time_str = (i == 4) ? $i : time_str " " $i

    rest = ""
    for (i = ago_idx + 1; i <= NF; i++) rest = (i == ago_idx + 1) ? $i : rest " " $i

    lines[NR] = lead " " change_id " " author
    times[NR] = time_str " ago"
    rests[NR] = rest

    tlen = length(time_str " ago")
    if (tlen > max_t) max_t = tlen
  }
  END {
    for (i = 1; i <= NR; i++) printf "%s  %-*s  %s\n", lines[i], max_t, times[i], rests[i]
  }'
}

# repo: open the current repository's web page (on the current branch unless it's main/master)
function repo {
  local url branch
  url=$(git config --get remote.origin.url 2>/dev/null | sed -E -e 's#^(ssh://)?git@([^:/]+)[:/]#https://\2/#' -e 's#\.git$##')
  [[ -n "$url" ]] || { echo "Not a git repository or no remote.origin.url is set." >&2; return 1; }
  branch=$(git rev-parse --abbrev-ref HEAD)
  [[ "$branch" == main || "$branch" == master || "$branch" == HEAD ]] || url="$url/tree/$branch"
  echo "$url"
  if [[ "$OSTYPE" == darwin* ]]; then open "$url"; else xdg-open "$url"; fi
}

# Hugo
# deploy [--go]: rsync public/ to pair (a dry run unless --go)
function deploy {
  local opts=(-azr --delete --include='.*' --stats --quiet --itemize-changes --log-file=rsync.log --log-file-format='%i %n%L')
  [[ "$1" == "--go" ]] || opts+=(--dry-run)
  rsync "${opts[@]}" public/ pair:~/public_html/zanshin
}

# drafts: list content files marked as drafts
function drafts { grep -rliE '^draft *[:=] *true' content/; }

# build: rebuild the site
function build { hugo --cleanDestinationDir; }

# create post|link|video|note TITLE...: new Hugo content, opened in Zed
function create {
  local type=$1 archetype slug
  shift
  case "$type" in
    post|link|video|note) archetype="${type}s" ;;
    *) echo "Usage: create post|link|video|note TITLE" >&2; return 1 ;;
  esac
  [[ -n "$*" ]] || { echo "Usage: create $type TITLE" >&2; return 1; }
  # non-alphanumerics to dashes, squeeze repeats, lowercase, trim end dashes
  slug=$(printf '%s' "$*" | sed -e 's/[^[:alnum:]]/-/g' | tr -s '-' | tr '[:upper:]' '[:lower:]' | sed -e 's/^-//' -e 's/-$//')
  hugo new "$archetype/$slug.md" && zed "content/$archetype/$slug.md"
}

# Files and directories
# ex FILE: extract any common archive format
function ex {
  [[ -f "$1" ]] || { echo "'$1' is not a valid file" >&2; return 1; }
  case "$1" in
    *.tar.bz2|*.tbz2) tar xvjf "$1" ;;
    *.tar.gz|*.tgz)   tar xvzf "$1" ;;
    *.tar.xz)         tar xvJf "$1" ;;
    *.tar.lzma)       tar --lzma -xvf "$1" ;;
    *.tar)            tar xvf "$1" ;;
    *.bz2)            bunzip2 "$1" ;;
    *.gz)             gunzip "$1" ;;
    *.rar)            unrar x "$1" ;;
    *.zip)            unzip "$1" ;;
    *.Z)              uncompress "$1" ;;
    *.7z)             7z x "$1" ;;
    *.dmg)            hdiutil mount "$1" ;;
    *) echo "'$1' cannot be extracted via ex" >&2; return 1 ;;
  esac
}

# findexec NAME [CMD]: run CMD (default: file) on each file whose name contains NAME
function findexec { find . -type f -iname "*${1:-}*" -exec "${2:-file}" '{}' \; ; }

# prettycsv FILE: view a CSV file as aligned columns
function prettycsv {
  [[ -n "$1" ]] || { echo "Usage: prettycsv FILE.csv" >&2; return 1; }
  column -s, -t < "$1" | less -FSXK
}

# tre [ARGS]: tree with hidden files and color, skipping .git, directories first
function tre { tree -aC -I '.git' --dirsfirst "$@" | less -FRNX; }

# mkd DIR: create a directory and cd into it
function mkd { mkdir -p "$@" && cd "${@: -1}"; }

# s / i: save the current directory, then return to it later
function s { pwd > ~/.save_dir; }
function i { cd "$(< ~/.save_dir)"; }

# v / n / z [FILES]: open FILES (default: the current directory) in vim / nvim / zed
function v { vim "${@:-.}"; }
function n { nvim "${@:-.}"; }
function z { zed "${@:-}"; }

# newscript NAME[.ext]: create an executable script in ~/bin and start editing it
# (an optional skeleton, ~/bin/.newscript_defaults/<ext>.txt, is appended)
function newscript {
  local dir="$HOME/bin" skel="$HOME/bin/.newscript_defaults" name=$1 ext file
  [[ -n "$name" ]] || { echo "Usage: newscript NAME[.ext]   (default extension: .sh)" >&2; return 1; }
  if [[ "$name" == *.* ]]; then ext=${name##*.}; else ext=sh; name="$name.sh"; fi
  file="$dir/$name"

  if [[ -e "$file" ]]; then
    printf '\033[31;1mFile exists: %s\033[0m\n' "$file"
  else
    case "$ext" in
      rb)      echo '#!/usr/bin/env ruby' ;;
      py)      echo '#!/usr/bin/env python3' ;;
      pl)      echo '#!/usr/bin/env perl' ;;
      sh|bash) echo '#!/usr/bin/env bash' ;;
      zsh)     echo '#!/usr/bin/env zsh' ;;
    esac > "$file"
    [[ -f "$skel/$ext.txt" ]] && cat "$skel/$ext.txt" >> "$file"
    echo >> "$file"
    chmod +x "$file"
    printf '\033[32;1m%s\033[0m\n' "$file"
  fi
  "${EDITOR:-nvim}" "$file"
}

# Processes
# any / psgrep PATTERN: running processes matching PATTERN (any ignores case)
# The [x]yz pattern keeps grep from matching its own process.
function any {
  [[ -n "$1" ]] || { echo "Usage: any PATTERN" >&2; return 1; }
  ps xauwww | grep -i --color=auto "[${1:0:1}]${1:1}"
}
function psgrep { ps auxww | grep "[${1:0:1}]${1:1}"; }
function psax { ps auxwwwh | grep -- "$@" | grep -v grep; }

# ram PATTERN: total memory used by processes whose name matches PATTERN
function ram {
  [[ -n "$1" ]] || { echo "Usage: ram PATTERN" >&2; return 1; }
  ps -axo rss=,comm= | awk -v app="$1" '
    { name = $0; sub(/^ *[0-9]+ +/, "", name) }
    index(tolower(name), tolower(app)) { sum += $1 }
    END {
      if (sum) printf "%s uses %.2f MBs of RAM.\n", app, sum / 1024
      else printf "No running processes match %s.\n", app
    }'
}

# clobber SESSION: kill tmux session SESSION and the terminal process holding it
function clobber {
  local pid ppid
  pid=$(pgrep -f "tmux.*$1" | head -1)
  [[ -n "$pid" ]] || { echo "No tmux process found for '$1'" >&2; return 1; }
  ppid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  echo "Killing tmux session '$1' (pid $pid) and its terminal process (pid $ppid)"
  tmux kill-session -t "$1"
  (( ppid > 1 )) && kill -9 "$ppid"
}

# Network
# inet: IPv4 address of each interface (loopback excluded)
function inet {
  if command -v ip >/dev/null 2>&1; then
    ip -4 -o addr show | awk '$4 !~ /^127\./ {print $2, $4}' | column -t
  else
    ifconfig | awk '/^[a-z]/ {iface = $1; sub(/:$/, "", iface)} /inet / && $2 !~ /^127\./ {print iface, $2}' | column -t
  fi
}

# myip: public IP, then each interface's address
function myip { echo "public ip: $(curl -s https://api.ipify.org)"; inet; }

# tmuxip: addresses on the 10.130 network, on one line
function tmuxip { ifconfig | awk '/inet 10\.130/ && !/broadcast/ {print $2}' | xargs; }

# nicemount: mounted filesystems as a table
function nicemount { (echo "DEVICE PATH TYPE FLAGS" && mount | awk '$2="";1') | column -t; }

# digg DOMAIN: the most useful parts of `dig`
function digg { dig +nocmd "$1" any +multiline +noall +answer; }

# netwtf: mtr report to 8.8.8.8
function netwtf { sudo "$(command -v mtr)" -b -o "LSD NBAW JX" 8.8.8.8; }

# Certificates
# showcert FILE: decode a certificate file
function showcert { openssl x509 -in "$1" -noout -text; }

# ssldates DOMAIN: validity dates of DOMAIN's certificate
function ssldates { openssl s_client -servername "$1" -connect "$1:443" </dev/null 2>/dev/null | openssl x509 -noout -dates; }

# getcertnames DOMAIN: the CN and SANs in DOMAIN's certificate
function getcertnames {
  [[ -n "$1" ]] || { echo "ERROR: No domain specified." >&2; return 1; }
  local cert
  echo "Testing $1…"
  cert=$(openssl s_client -servername "$1" -connect "$1:443" </dev/null 2>/dev/null | openssl x509 -noout -text 2>/dev/null)
  [[ -n "$cert" ]] || { echo "ERROR: Certificate not found." >&2; return 1; }
  echo; echo "Common Name:"
  sed -n 's/.*Subject:.*CN *= *//p' <<< "$cert"
  echo; echo "Subject Alternative Name(s):"
  grep -A1 "Subject Alternative Name:" <<< "$cert" | tail -n 1 | tr ',' '\n' | sed -e 's/^ *DNS://'
}

# mycerts: certificate dates for my sites
function mycerts {
  local site sites=(   # label:host
    zanshin:zanshin.net books:books.zanshin.net geek:geek.zanshin.net health:health.zanshin.net
    music:music.zanshin.net matomo:matomo.zanshin.net mint:mint.zanshin.net
    sibyllekuder:sibyllekuder.com notes:notes.sibyllekuder.com blog:blog.sibyllekuder.com
    mint-sk:mint.sibyllekuder.com jonathankuder:jonathankuder.com
    hannelorebohlig:hannelorebohlig.com aiydk:andifyoudidknow.com markhnichols:markhnichols.com
  )
  for site in "${sites[@]}"; do
    printf '%-16s' "${site%%:*}"
    ssldates "${site#*:}" | paste - -
  done
}

# Docker
# dcleanup: remove exited containers and dangling images
function dcleanup {
  docker rm -v $(docker ps --filter status=exited -q 2>/dev/null) 2>/dev/null
  docker rmi $(docker images --filter dangling=true -q 2>/dev/null) 2>/dev/null
}

# del_stopped NAME: remove container NAME if it isn't running
function del_stopped {
  [[ "$(docker inspect --format '{{.State.Running}}' "$1" 2>/dev/null)" == "false" ]] && docker rm "$1"
}

# relies_on CONTAINER...: start each container (via its function) if not running
function relies_on {
  local c state
  for c in "$@"; do
    state=$(docker inspect --format '{{.State.Running}}' "$c" 2>/dev/null)
    if [[ "$state" != "true" ]]; then
      echo "$c is not running, starting it for you."
      "$c"
    fi
  done
}

function cows { docker run --rm -it --name cowsay zanshin/cowsay; }

# Shell helpers

# path: PATH, one entry per line, with common segments colored
function path {
  tr ':' '\n' <<< "$PATH" | awk -v g='\033[0;32m' -v b='\033[1;34m' -v c='\033[0;36m' -v p='\033[0;35m' -v br='\033[0;33m' -v r='\033[0m' '{
    gsub("/usr", g "/usr" r); gsub("/sbin", p "/sbin" r); gsub("/bin", b "/bin" r)
    gsub("/opt", c "/opt" r); gsub("/local", br "/local" r)
    print
  }'
}

# newalias NAME: save the previous command as alias NAME and load it
function newalias {
  local file="$HOME/.config/bash.d/aliases" cmd q="'"
  [[ -n "$1" ]] || { echo "Usage: newalias NAME" >&2; return 1; }
  cmd=$(history -p '!!') || return
  printf "alias %s='%s'\n" "$1" "${cmd//$q/$q\\$q$q}" >> "$file"
  source "$file"
}

# givedef WORD: dictionary definition
function givedef {
  [[ $# -eq 1 ]] || { echo "Usage: givedef WORD" >&2; return 1; }
  curl -s "dict://dict.org/d:$1"
}

# explain ['CMD']: explain a shell command via mankier.com (interactive with no argument)
function explain {
  local cmd url="https://www.mankier.com/api/explain/?cols=$(tput cols)"
  case $# in
    0) while read -r -p "Command: " cmd; do curl -Gs "$url" --data-urlencode "q=$cmd"; done; echo "Bye!" ;;
    1) curl -Gs "$url" --data-urlencode "q=$1" ;;
    *) printf '%s\n' "Usage:" "  explain                  interactive mode" "  explain 'cmd -o | ...'   explain one quoted command" ;;
  esac
}

# tsize: terminal window size
function tsize { echo "$(tput cols) wide by $(tput lines) tall"; }

# macOS only
if [[ "$OSTYPE" == darwin* ]]; then

  # pman PAGE: open a man page as a PDF in Preview
  function pman {
    local pdf="${TMPDIR:-/tmp}/man-${*// /-}.pdf"
    mandoc -T pdf "$(man -w "$@")" > "$pdf" && open "$pdf"
  }

  # ips: IP assignments, via ~/bin/getip.py
  function ips { echo $(~/bin/python/getip.py; ~/bin/python/getip.py en0; ~/bin/python/getip.py en1); }

  # notify TITLE SUBTITLE MESSAGE: notification via an Automator workflow
  function notify { automator -D title="$1" -D subtitle="$2" -D message="$3" ~/Library/Workflows/DisplayNotification.wflow; }

  # console [WORD...]: follow the system log, optionally only lines matching any WORD
  function console {
    if (( $# )); then
      log stream --style compact | grep -i --line-buffered --color=auto -E "$(IFS='|'; echo "$*")"
    else
      log stream --style compact
    fi
  }

  # hiddenOn / hiddenOff: show or hide hidden files in Finder
  function hiddenOn { defaults write com.apple.finder AppleShowAllFiles YES && killall Finder; }
  function hiddenOff { defaults write com.apple.finder AppleShowAllFiles NO && killall Finder; }

fi
