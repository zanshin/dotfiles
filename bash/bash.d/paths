#!/bin/bash

# -------------------------------------------------------------------
# paths
#
# Sets up the PATH environment variable. On macOS, PATH is reset and
# rebuilt with path_helper (/etc/paths + /etc/paths.d) before user
# directories are added.
#
# Path is assembled in three groups: front + system + back
# Directories that don't exist are skipped, duplicates are dropped
# (first occurrence wins), and anything matching _path_skip is left out.
# -------------------------------------------------------------------

# Rebuild the system base on macOS ($OSTYPE avoids a uname subprocess)
if [[ "$OSTYPE" == "darwin*" ]]; then
  PATH=""
  [[ -x /usr/libexec/path_helper ]] && eval "$(/usr/libexec/path_helper -s)"
fi

# Entries to drop even if they exist (globs allowed)
_path_skip=(
  "/pkg/env/global/bin"                        # empty, origin unknown
  "/var/run/com.apple.security.cryptexd/*"     # empty cryptex bootstrap mounts
)

# Ahead of the system directories (these win name collisions)
_path_front=(
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"
  "$HOME/code/golib/bin"
  /opt/homebrew/bin
  /opt/homebrew/sbin
)

# After the system directories
_path_back=(
  /usr/local/sbin
  /usr/local/bin
  /usr/local/go/bin
  /usr/local/protobuf/bin
  "$HOME/bin"
  "$HOME/bin/bash"
  "$HOME/bin/ruby"
  "$HOME/bin/python"
  "$HOME/bin/perl"
  "${REX_BIN_DIR:-}"
)

# Assemble
IFS=: read -ra _path_sys <<< "$PATH"

_path_new=""
for _dir in "${_path_front[@]}" "${_path_sys[@]}" "${_path_back[@]}"; do
  [[ -n "$_dir" && -d "$_dir" ]] || continue
  for _skip in "${_path_skip[@]}"; do
    [[ "$_dir" == $_skip ]] && continue 2   # unquoted RHS = glob match
  done
  [[ ":$_path_new:" == *":$_dir:"* ]] && continue
  _path_new="${_path_new:+$_path_new:}$_dir"
done

PATH="$_path_new"
export PATH

unset _path_skip _path_front _path_back _path_sys _path_new _dir _skip
