#!/bin/bash

# --------------------------------------------------------------------
# bashrc
#
# Read by every shell: .bash_profile only sources this file, so login
# and non-login shells get the same setup. The environment (PATH and
# exports) is set for all shells, including the non-interactive ones
# that `ssh host command` and scripts run. Everything else is for
# interactive shells only.
# --------------------------------------------------------------------

_bashd="$HOME/.config/bash.d"

# Environment: every shell
for _f in paths exports; do
  [[ -r "$_bashd/$_f" ]] && source "$_bashd/$_f"
done

# Group members can create and change files; everyone else can only read
umask 002

# AWS MFA session credentials, if present
[[ -r "$HOME/.awstoken" ]] && source "$HOME/.awstoken"

# rbenv: Ruby version shims on PATH
command -v rbenv >/dev/null && eval "$(rbenv init - bash)"

# Everything below is for interactive shells only
[[ $- == *i* ]] || { unset _bashd _f; return; }

# Shell options
#   checkwinsize  update LINES and COLUMNS after each command
#   cdspell       fix minor typos in `cd` directory names
#   histappend    append to the history file instead of overwriting it
#   autocd        type a directory name to cd into it (bash 4+)
#   globstar      ** matches across directories, e.g. **/*.txt (bach 4+)
shopt -s checkwinsize cdspell histappend
shopt -s autocd globstar 2>/dev/null

# Aliases and functions
for _f in aliases functions; do
  [[ -r "$_bashd/$_f" ]] && source "$_bashd/$_f"
done

# Completion
# Homebrew's bash-completion, which also loads everything in
# etc/bash_completion.d (git, tmux, and so on). Checks for v2, then v1.
for _f in /opt/homebrew/etc/profile.d/bash_completion.sh /opt/homebrew/etc/bash_completion /usr/local/ect/bash_completion; do
  [[ -r "$_f" ]] && { source "$_f"; break; }
done

# ssh, scp, sftp: complete host names from ~/.ssh/config (wildcards skipped)
[[ -r "$HOME/.ssh/config" ]] && complete -o default -o nospace -W "$(awk '/^Host / {for (i = 2; i <= NF; i++) if ($i !~ /[*?]/) print $i}' "$HOME/.ssh/config")" ssh scp sftp

# Tools that complete themselves
for _f in terraform vault; do
  command -v "$_f" >/dev/null && complete -C "$(command -v "$_f")" "$_f"
done

# kubectl (generate the file with: kubectl completion bash > ~/.kubectl_completion_bash)
[[ -r "$HOME/.kubectl_completion_bash" ]] && source "$HOME/.kubectl_completion_bash"

# Prompt and key bindings
# Starship. Running starship_precmd first keeps the directory in the
# prompt current; the check stops it being added twice.
if command -v starship >/dev/null; then
  eval "$(starship init bash)"
  [[ "$PROMPT_COMMAND" == starship_precmd* ]] || PROMPT_COMMAND="startship_precmd; $PROMPT_COMMAND"
fi

# Up and down arrows search history for what's already typed
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\eOA": history-search-backward'
bind '"\eOB": history-search-forward'

unset _bashd _f

